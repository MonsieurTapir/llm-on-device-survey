<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>On-device LLM inference survey</title>
<style>{{ css | safe }}</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="top">
      <h1>On-device LLM inference survey</h1>
      <a class="source" href="{{ project_url }}">Methodology and source</a>
      <details class="add">
        <summary>Add your machine</summary>
        <div class="add-body">
          <div class="fine">Linux / macOS</div>
          <code>{{ install_bash }}</code>
          <div class="fine">Windows (PowerShell)</div>
          <code>{{ install_ps }}</code>
          <div class="fine">Downloads a prebuilt kit and the models (about 8 GB), measures for 15 to 60 minutes,
            and writes a results file to attach to a
            <a href="{{ project_url }}/issues/new?template=submission.yml">submission issue</a>.</div>
        </div>
      </details>
    </div>
  </header>

  {% if empty %}
  <p class="fine empty">No submissions yet.</p>
  {% else %}
  <div class="shell">
    <aside class="rail" aria-label="Task and fleet">
      <div>
        <span class="field-label">Model</span>
        <select class="pick" id="models" aria-label="Model"></select>
      </div>
      <div>
        <span class="field-label">Task</span>
        <div class="ctl">
          <label for="in-prompt">Prompt</label>
          <input type="number" id="in-prompt" min="0" max="32768" step="16" aria-describedby="u-prompt">
          <span class="unit" id="u-prompt">tokens</span>
          <input type="range" id="r-prompt" min="0" max="1000" aria-label="Prompt length">
          <div class="stops" id="s-prompt"></div>
        </div>
        <div class="ctl">
          <label for="in-out">Reply</label>
          <input type="number" id="in-out" min="0" max="8192" step="16" aria-describedby="u-out">
          <span class="unit" id="u-out">tokens</span>
          <input type="range" id="r-out" min="0" max="1000" aria-label="Reply length">
          <div class="stops" id="s-out"></div>
        </div>
        <div class="zones">
          <span class="zones-title" id="zones-title">Finish within</span>
          <div class="split" id="split-zone" aria-labelledby="zones-title"></div>
          <div class="sp-legend even" id="legend-zone"></div>
        </div>
      </div>
      <div>
        <span class="field-label">Backends</span>
        <div class="checks" id="backends"></div>
      </div>
      <div>
        <span class="field-label">Fleet</span>
        <div class="sp-title">Classes</div>
        <div class="split" id="split-kind"></div>
        <div class="sp-legend list" id="legend-kind"></div>
        <div class="sp-title">Tiers inside each class</div>
        <div class="split" id="split-tier"></div>
        <div class="sp-legend" id="legend-tier"></div>
        <p class="fine fleet-note">Placeholder shares, not market data.</p>
      </div>
    </aside>

    <div class="stage">
      <div class="tabs" role="tablist" id="tabs">
        <button role="tab" data-view="coverage">Coverage</button>
        <button role="tab" data-view="compare" id="tab-compare">Compare</button>
        <button role="tab" data-view="data">Data</button>
      </div>

      <div class="panel" id="view-coverage">
        <div class="stats">
          <div class="stat" id="cover">
            <span class="field-label">Fleet coverage</span>
            <b id="cov-num"></b>
            <span id="cov-sub"></span>
          </div>
          <div class="stat" id="memory">
            <span class="field-label">Memory reserved</span>
            <b id="mem-num"></b>
            <span id="mem-sub"></span>
          </div>
        </div>
        <div class="chart" id="map"></div>
        <div class="key" id="map-key"></div>
      </div>

      <div class="panel" id="view-compare" hidden>
        <div class="toolbar">
          <select class="pick" id="sel-add" aria-label="Add a machine to compare"></select>
          <span class="fine" id="sel-label"></span>
        </div>
        <p class="fine" id="cmp-empty" hidden>Nothing selected. Add a machine above, click marks on the map, or tick rows in the data table.</p>
        <div id="cmp-body" class="panel">
          <div>
            <h3>This task, side by side</h3>
            <div class="rows" id="cmp-rows"></div>
            <div class="key" id="cmp-key"></div>
          </div>
          <div>
            <div class="toolbar">
              <h3>As the task grows</h3>
              <span class="seg" id="scale-var"></span>
            </div>
            <div class="chart" id="scale"></div>
          </div>
          <div>
            <h3>Numbers</h3>
            <div class="scroll-x"><table class="cmp" id="cmp-table"></table></div>
          </div>
        </div>
      </div>

      <div class="panel" id="view-data" hidden>
        <div class="toolbar">
          <input type="search" id="q" placeholder="Search: rtx, apple, vulkan, windows…" aria-label="Search machines and devices">
          <label><input type="checkbox" id="best-only" checked> fastest device per machine only</label>
          <label><input type="checkbox" id="all-models"> all models</label>
          <label><input type="checkbox" id="only-ok"> within target only</label>
          <span class="fine" id="data-count"></span>
          <button class="btn push" id="copy" type="button">Copy as TSV</button>
        </div>
        <div class="scroll-x"><table class="data" id="data"></table></div>
      </div>
    </div>
  </div>
  {% endif %}
</div>
{% if not empty %}
<div id="tip" hidden></div>
<script type="application/json" id="pack">{{ pack | tojson }}</script>
<script>{{ tasks_js | safe }}</script>
<script>{{ fleet_js | safe }}</script>
<script>{{ report_js | safe }}</script>
{% endif %}
</body>
</html>
